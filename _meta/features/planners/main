#!/usr/bin/env bash

name="planners"
_py="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/planners.py"

# === MAIN SCRIPT ===
help(){
    echo "Usage: $name <update|uninstall|source|add|rm|ls|check>"
    echo ""
    echo "Per-planner submodule management."
    echo "  add <name...>     clone planner's submodules"
    echo "  rm <name...>      deinit planner's submodules"
    echo "  ls                list planners, [x] ready, [ ] pending"
    echo "  check [--all]     verify planner submodules are initialized"
    echo "  update            refresh initialized planner submodules"
    echo "  uninstall         deinit all planner submodules"
}
if [ $# -lt 1 ]; then
    help
    exit 1
fi
case "$1" in
    add|update)
        python3 "$_py" "$@" || exit $?
        arena deps && arena build
        exit $?
    ;;
    rm|ls|check)
        python3 "$_py" "$@"
        exit $?
    ;;
    uninstall)
        python3 "$_py" uninstall
        arena registry remove "$name"
        # shellcheck disable=SC2317
        return $? 2>/dev/null || exit $?
    ;;
    source)
        return 0
    ;;
    *)
        help
        exit 1
    ;;
esac
