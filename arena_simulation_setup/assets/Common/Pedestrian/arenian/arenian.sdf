<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="arenian">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <!-- Static mesh baked from frame 17 of Fuel Mingfei/actor walk.dae (tools/bake_pose.py).
             The original skinned walk.dae renders in its bind pose (T-pose) when used as a plain
             visual. Baked mesh is in scene frame: feet at z=0, facing +x. Visual only, no collision. -->
        <geometry>
          <mesh>
            <uri>meshes/arenian_walk.dae</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
