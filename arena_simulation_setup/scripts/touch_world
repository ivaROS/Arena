#! /usr/bin/env python
import argparse
import ast
import os
from pathlib import Path

from arena_simulation_setup.tree.World import MultiLevelWorldView

parser = argparse.ArgumentParser(description="Render a world's map preview, or with --all regenerate its world.yaml + per-level maps.")
parser.add_argument('world_name', type=str, help='Name of the world to touch.')
parser.add_argument('--all', action='store_true', help='Regenerate canonical world.yaml + per-level maps in the source tree (not just a preview).')
parser.add_argument('--assets', help='Color to draw assets in.', default=None)
parser.add_argument('--assets-label', help='Color to draw asset labels in.', default=None)
parser.add_argument('--assets-bbox', help='Default bounding box for static entities as ((xmin, xmax), (ymin, ymax)).', default=None)
parser.add_argument('--resolution', type=float, help='Resolution of the generated map in meters per pixel.', default=0.05)
args = parser.parse_args()

render_kwargs: dict = {}
if args.assets_bbox is not None:
    try:
        render_kwargs['default_asset_bbox'] = ast.literal_eval(args.assets_bbox)
    except Exception as e:
        print(f"Error parsing assets_bbox: {e}")
        exit(1)
if args.assets is not None:
    render_kwargs['asset_color'] = args.assets
if args.assets_label is not None:
    render_kwargs['asset_name_color'] = args.assets_label

base_dir = os.getcwd()
if (arena_dir := os.environ.get('ARENA_DIR')) is not None:
    base_dir = os.path.join(arena_dir, 'arena_simulation_setup', 'worlds')

world_path = Path(os.path.join(base_dir, args.world_name))
view = MultiLevelWorldView(world_path)
world = view.load()

if args.all:
    view.save(world, resolution=args.resolution, **render_kwargs)
    print(f"Regenerated world.yaml + maps for '{args.world_name}' at {world_path}")
else:
    level_origins = view.level_origins()
    origins = level_origins if level_origins is not None else {fid: (0.0, 0.0) for fid in world.level_ids}
    description = world.compact_world(origins=origins)
    png_bytes, map_yaml_out = description.render_map_files(level_origins=level_origins, resolution=args.resolution, **render_kwargs)
    (world_path / 'map.png').write_bytes(png_bytes)
    (world_path / 'map.yaml').write_text(map_yaml_out)
    print(f"Rendered preview map for '{args.world_name}' to {world_path}")
